[Unit]
Description=Dahua Money Watch one-shot scanner
After=network.target

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.venv/bin/dahua-money-watch run-once --config __PROJECT_DIR__/configs/production.example.json
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
